# Databricks workspace (required)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXX

# SQL warehouse (id is optional; provision looks up DATABRICKS_WAREHOUSE_NAME)
# DATABRICKS_WAREHOUSE_ID=
# DATABRICKS_WAREHOUSE_NAME=ecommerce-genie-ontology

# Optional OAuth M2M instead of a PAT
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# Account API (required for POST /api/v1/ontology/provision-workspace)
# DATABRICKS_ACCOUNT_ID=
# DATABRICKS_ACCOUNT_HOST=https://accounts.cloud.databricks.com
# DATABRICKS_WORKSPACE_NAME=ecommerce-genie-ontology
# DATABRICKS_AWS_REGION=us-east-1
# Human users who should open the workspace UI (comma-separated)
# DATABRICKS_WORKSPACE_ADMIN_EMAILS=you@example.com

# Unity Catalog targets (created by: npm run ecommerce:catalog:databricks-setup)
DATABRICKS_CATALOG=ecommerce_genie_ontology
DATABRICKS_SCHEMA=retail_demo
DATABRICKS_OLTP_SCHEMA=retail_oltp
# DATABRICKS_OLTP_CUSTOMERS=200
# DATABRICKS_OLTP_ORDERS_PER_YEAR=25000
# DATABRICKS_OLTP_YEARS=3

# Workspace folder where notebooks + package are uploaded for Databricks Jobs
DATABRICKS_WORKSPACE_PATH=/Workspace/Shared/ecommerce-genie-ontology

# Genie agent (same host/token as Databricks unless overridden)
GENIE_AGENT_TITLE=Retail Analytics Genie
# GENIE_HOST=
# GENIE_TOKEN=
# GENIE_SPACE_ID=
# GENIE_PARENT_PATH=/Workspace/Users/you@example.com

# Optional LLM keys for chat facades (LangGraph / Google ADK)
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
